# Copy this file to .env (or just run: topstep-bot setup). Keep .env private - never share or commit it.

# TopstepX login name (NOT your email) and an API key from TopstepX -> Settings -> API
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=

# Optional alerts
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a read-only GitHub token so the bot can check for updates (topstep-bot update --token sets it up)
GITHUB_TOKEN=
